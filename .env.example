# Copy to .env.local and fill in your keys. Restart `npm run dev` after saving.

# EmailJS — https://www.emailjs.com (free tier: 200 emails/month)
# 1. Add Gmail service connected to Emunetluna@gmail.com
# 2. Create an HTML template (see CONTACT_EMAILJS_TEMPLATE below)
# 3. Paste the three IDs/keys from your EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: Google reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# --- EmailJS template setup (create in EmailJS dashboard) ---
# Template name: Luna Cottage Inquiry
# To email: Emunetluna@gmail.com
# Reply-To: {{reply_to}}
# Subject: {{subject}}
# Content type: HTML
# Body (single line is fine):
# {{{html_message}}}
